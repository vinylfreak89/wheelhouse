#!/usr/bin/env python3
"""codex-run — the ONLY sanctioned way to drive Codex from Claude.

Exists because prose instructions get shortcut. Starting bridge.py directly
"works" but leaves the user with no window to watch, which defeats the point.
Every subcommand runs the same preflight: GUI up, bridge ready, then act.

  codex-run up                       ensure Wheelhouse.app + bridge are running
  codex-run new [cwd]                reuse-or-create THIS CHAT's thread, print id
  codex-run rename [<id>] "<name>"   retitle a thread (safe: resolution is by chat)
  codex-run lock [status|acquire|release]  advisory lock on this checkout
  codex-run project [--name N]       show/set the project a thread displays under
  codex-run project --repair         pin any threads created before the registry
                                     (the name is always the chat title -- it is
                                      deliberately not overridable; one chat maps
                                      to exactly one Codex thread)
  codex-run tid                      just print this chat's thread id
  codex-run send <id> "<text>"       send a turn, wait, print the reply
  codex-run task <id> <file> [--effort E] [--cwd DIR] [--skill NAME]
                                     send a turn whose prompt is a FILE
                                     --effort low|medium|high|xhigh|max|ultra
                                       (default xhigh; match it to the work)
                                     --cwd  REQUIRED when the work writes
                                       outside the thread's own directory --
                                       workspace-write scopes writes to cwd
  codex-run stop <id>                interrupt the active turn
  codex-run on-file <path> <id> <file> [--effort E] [--cwd D]
                                     wait for <path> to appear AND stop growing,
                                     then dispatch <file> as a turn. Codex has no
                                     wait-for-trigger of its own -- continuation
                                     is always the orchestrator's job.
  codex-run queue <id> "<text>"      queue a follow-up turn (runs after current)
  codex-run busy                     is any thread mid-turn? (exit 1 if yes)
  codex-run reload                   hot-reload the UI (no restart, no turn loss)
  codex-run restart [--force]        restart the app; REFUSES while a turn runs
  codex-run watch <id> [secs]        follow status / sub-agents / tokens
  codex-run agents <id>              sub-agent threads of this thread
  codex-run errors <id>              error-ish lines from the transcript
  codex-run steer <id> "<text>"      type into a RUNNING turn
  codex-run say "<text>"             new + send, auto-named from the chat (most common)
  codex-run say "<name>" "<text>"    same, with an explicit name
  codex-run name                     show the name that would be used
  codex-run list                     threads, with status
  codex-run info <id>                effective model/effort/sandbox/tokens
  codex-run read <id>                transcript
  codex-run archive <id>             tidy up (with its sub-agents), KEEPS transcripts
  codex-run rm <id>                  delete permanently, INCLUDING its sub-agents
                                     (destroys their rollouts)
"""
import json, os, subprocess, sys, time, urllib.error, urllib.request

PORT = int(os.environ.get("CODEX_BRIDGE_PORT", "8770"))
B = f"http://127.0.0.1:{PORT}"
# Resolve everything relative to this file, not to one machine's layout.
# realpath() matters: this script is normally reached through a symlink on
# PATH, and __file__ would otherwise point at the symlink's directory.
ROOT = os.environ.get("CODEX_APP_DIR") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
APP = os.path.join(ROOT, "Wheelhouse.app")
BRIDGE_PY = os.path.join(ROOT, "bridge.py")
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)
from project_registry import project_for_path, project_label, rollout_creation_cwd


def _req(path, obj=None, timeout=300):
    data = json.dumps(obj).encode() if obj is not None else None
    r = urllib.request.Request(B + path, data=data,
                               headers={"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(r, timeout=timeout))


def alive():
    try:
        _req("/status", None, 2)
        return True
    except Exception:
        return False


def gui_running():
    out = subprocess.run(["pgrep", "-f", f"{APP}/Contents/MacOS"],
                         capture_output=True, text=True)
    return bool(out.stdout.strip())


def bridge_up_headless(quiet=False):
    """Run bridge.py ourselves, detached, with no window.

    Redirect to /dev/null and start a new session so the bridge outlives this
    process -- otherwise every CLI invocation would kill the server it just
    started.
    """
    if not os.path.isfile(BRIDGE_PY):
        sys.exit(f"no bridge at {BRIDGE_PY}")
    if not quiet:
        print("starting bridge (headless) ...")
    devnull = open(os.devnull, "wb")
    subprocess.Popen([sys.executable, BRIDGE_PY],
                     stdout=devnull, stderr=devnull, stdin=subprocess.DEVNULL,
                     start_new_session=True, cwd=ROOT)


def up(quiet=False):
    """Ensure the bridge is reachable, with or without a window.

    The GUI is preferred when a bundle exists -- the window is the point -- but
    the CLI must not depend on it: over SSH, on a machine where the app was
    never built, or when $CODEX_HEADLESS=1, run bridge.py directly instead.

    Keyed on the bridge being ALIVE rather than on the GUI being up. A running
    GUI whose bridge has died used to take the launch branch, do nothing (the
    app was already open), then wait a full minute for a server nothing was
    going to start.
    """
    if alive():
        if not quiet:
            print("already up")
        return
    headless = (os.environ.get("CODEX_HEADLESS") == "1"
                or not os.path.isdir(APP))
    if headless or gui_running():
        # gui_running() here means the app is up but its bridge is not
        # answering -- starting our own is the only way to recover in-process.
        bridge_up_headless(quiet)
    else:
        if not quiet:
            print("launching Wheelhouse.app ...")
        subprocess.run(["open", APP], check=False)
    for _ in range(120):                       # ~60s
        if alive():
            if not quiet:
                print("bridge ready")
            return
        time.sleep(0.5)
    hint = ("the app is running but its bridge is not answering; quit and reopen it"
            if gui_running() else f"try: python3 {BRIDGE_PY}")
    sys.exit(f"bridge did not come up on {PORT}. {hint}")


def rpc(method, params=None, timeout=300):
    up(quiet=True)
    r = _req("/rpc", {"method": method, "params": params or {}, "timeout": timeout},
             timeout + 20)
    if "error" in r:
        sys.exit(f"{method} failed: {json.dumps(r['error'])[:300]}")
    return r.get("result", {})


CLAUDE_SESSIONS_DIR = os.path.expanduser(
    "~/Library/Application Support/Claude/claude-code-sessions")


def _session_recency(session):
    """Comparable timestamp for the fallback path when no session id exists."""
    from datetime import datetime
    value = session.get("lastActivityAt") or session.get("lastFocusedAt") or 0
    if isinstance(value, (int, float)):
        return float(value)
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return 0
    return 0


def _claude_sessions():
    """Yield live Claude desktop session records, tolerating partial files."""
    import glob
    for path in glob.glob(os.path.join(CLAUDE_SESSIONS_DIR, "*", "*", "*.json")):
        if os.path.basename(path).startswith("deleted_"):
            continue
        try:
            with open(path, encoding="utf-8") as f:
                session = json.load(f)
        except Exception:
            continue
        if isinstance(session, dict) and not session.get("isArchived"):
            yield session


def chat_session():
    """Return the driving Claude session record, when discoverable."""
    sessions = list(_claude_sessions())
    hints = [v for v in (
        os.environ.get("CLAUDE_CODE_HOST_SESSION_ID"),
        os.environ.get("CLAUDE_CODE_SESSION_ID"),
    ) if v]
    for hint in hints:
        for session in sessions:
            if hint in (session.get("sessionId"), session.get("cliSessionId")):
                return session
    if hints:
        return {"sessionId": hints[0]}

    here = os.path.abspath(os.getcwd())
    candidates = []
    for session in sessions:
        cwd = os.path.abspath(session.get("cwd") or session.get("originCwd") or "")
        if cwd == here and session.get("title"):
            candidates.append(session)
    return max(candidates, key=_session_recency) if candidates else None


def chat_identity():
    """Return ``(stable session id, title)`` for the driving Claude chat.

    Claude exports both the desktop record's ``sessionId`` and its
    ``cliSessionId``. Resolve either representation to the record and store the
    canonical ``sessionId`` in Wheelhouse's registry. This avoids confusing two
    chats merely because they share a cwd and one became active more recently.

    Direct terminal use has no Claude session environment. Preserve the old
    cwd/recency lookup there as a best-effort fallback.
    """
    session = chat_session()
    if not session:
        return None, None
    stable = session.get("sessionId") or session.get("cliSessionId")
    return stable, session.get("title")


def claude_project(source_path=None, prefer_session=True):
    """Resolve a project from Claude's registry, never from mutable Codex cwd."""
    session = chat_session() if prefer_session else None
    source = ((session or {}).get("originCwd") or (session or {}).get("cwd")
              or source_path)
    return project_for_path(source)


def chat_title():
    """The title of the Claude chat that is driving this, when discoverable."""
    return chat_identity()[1]


def default_name(cwd=None):
    """Just the chat title.

    No "[project]" prefix: the sidebar groups threads by their saved project
    binding, so the prefix was only ever a workaround for the missing registry.
    """
    t = chat_title()
    if t:
        return t
    return os.path.basename(project_cwd(cwd).rstrip("/")) or "codex session"


def project_cwd(explicit=None):
    """Return the requested runtime working directory, never project identity."""
    return os.path.abspath(explicit or os.environ.get("CODEX_CWD") or os.getcwd())


# ---------------------------------------------------------------- projects
# A thread belongs to a Claude PROJECT. That identity comes from Claude's own
# registered project roots and the driving chat's persisted origin, never from
# Codex's mutable runtime cwd. Writing work elsewhere is routine and must not
# relocate the conversation.
REGISTRY = os.path.join(ROOT, "state", "projects.json")


def _registry():
    try:
        with open(REGISTRY, encoding="utf-8") as f:
            r = json.load(f)
        if isinstance(r, dict):
            r.setdefault("threads", {})
            r.setdefault("roots", {})
            r.setdefault("chats", {})
            return r
    except Exception:
        pass
    return {"threads": {}, "roots": {}, "chats": {}}


def _registry_save(reg):
    os.makedirs(os.path.dirname(REGISTRY), exist_ok=True)
    tmp = REGISTRY + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(reg, f, indent=2, sort_keys=True)
    os.replace(tmp, REGISTRY)          # atomic; never a half-written registry


def project_name(root=None):
    """Return the project's independent display name.

    The registry stores names separately from both project roots and mutable
    thread working directories. A root's basename is only the initial default;
    $CODEX_PROJECT and `codex-run project --name` provide an explicit name.
    """
    root = os.path.abspath(root or project_cwd())
    env = (os.environ.get("CODEX_PROJECT") or "").strip()
    if env:
        return env
    named = _registry()["roots"].get(root)
    if named:
        return named
    return project_label(root)


def bind_project(tid, root=None, name=None, capture_chat=True):
    """Pin a thread to the project registered by Claude for its source path."""
    source = os.path.abspath(root or project_cwd())
    discovered = claude_project(source, prefer_session=capture_chat)
    if not discovered and not name:
        return None
    root = discovered or source
    reg = _registry()
    if name:
        reg["roots"][root] = name
    entry = reg["threads"].get(tid) or {}
    entry = {**entry, "root": root,
             "name": name or reg["roots"].get(root) or project_name(root)}
    reg["threads"][tid] = entry
    # Bulk legacy repair is not being driven by each repaired thread's owning
    # chat. Stamping the current chat onto all of them cross-wires identity, so
    # only normal create/reuse paths capture the caller's chat.
    chat_id, title = chat_identity() if capture_chat else (None, None)
    if title and not entry.get("chat"):
        entry["chat"] = title
    else:
        entry.setdefault("chat", "")
    if chat_id:
        entry.setdefault("chat_id", chat_id)
        # One Claude chat owns one canonical Codex thread. First binding wins;
        # a later CWD-created duplicate must never replace it implicitly.
        reg["chats"].setdefault(chat_id, tid)
    reg["roots"].setdefault(entry["root"], entry["name"])
    _registry_save(reg)
    return entry


def project_of(tid):
    return _registry()["threads"].get(tid)


def thread_origin_cwd(tid):
    """Read a thread's immutable creation cwd from its rollout metadata.

    `thread.cwd` is mutable and therefore cannot repair project membership.
    The first session_meta record was written when the thread was created and
    remains stable even after later `--cwd` or settings updates.
    """
    thread = (rpc("thread/read", {"threadId": tid}, 40).get("thread") or {})
    path = thread.get("path") or thread.get("rolloutPath")
    if not path:
        return None
    return rollout_creation_cwd(path)


def repair_projects():
    """Pin legacy threads without consulting their mutable runtime cwd.

    Chat identity is intentionally left empty: this bulk operation runs from
    one caller and cannot know which Claude chat owns every other thread. A
    later invocation from the owning chat adds that identity lazily.
    """
    fixed = 0
    skipped = []
    for thread in rpc("thread/list", {"limit": 200}, 40).get("data", []):
        tid = thread["id"]
        source = thread_origin_cwd(tid)
        root = claude_project(source, prefer_session=False)
        if not root:
            skipped.append(tid)
            continue
        before = project_of(tid)
        after = bind_project(tid, source, capture_chat=False)
        if after != before:
            fixed += 1
    return fixed, skipped


DEFAULT_EFFORT = os.environ.get("CODEX_EFFORT", "xhigh")
# Match the orchestrator's own posture rather than forcing full autonomy on
# every new thread. `never` returns sandbox failures straight to the agent and
# never asks -- strictly more permissive than the Claude session driving it,
# which still stops for risky work. `auto-review` keeps the sandbox and routes
# approvals to the review agent, which is the closer analogue.
DEFAULT_APPROVALS = os.environ.get("CODEX_APPROVALS", "auto-review")


# ------------------------------------------------------------------ tree lock
# Two agents write this checkout: this CLI and whatever Codex does inside a turn.
# Without exclusion they interleave -- one `git add` sweeps up the other's
# half-finished edits (observed: an approvals fix landed inside a commit about
# turn parameters), and reloading the UI mid-write serves broken JS.
#
# ADVISORY, not enforced by the filesystem: it works because both sides check.
# A lock whose owner process is gone is stale and may be broken; a lock held by
# a LIVE process must be waited on, never stolen silently.
LOCKFILE = os.path.join(os.path.dirname(REGISTRY), "tree.lock")


def _lock_read():
    try:
        with open(LOCKFILE, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def _alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


#: a manual hold with no live process is abandoned after this long
LOCK_MAX_AGE = int(os.environ.get("LOCK_MAX_AGE", "3600"))


def lock_status():
    """Staleness has TWO forms, because holders differ.

    A `task` turn holds the lock inside a long-lived process, so a dead pid
    means abandoned. A manual `lock acquire` returns to the shell immediately --
    its pid is gone by the next command, which is normal, not stale. Those holds
    record pid null and expire on AGE instead.
    """
    d = _lock_read()
    if not d:
        return None
    pid = d.get("pid")
    if pid is not None and not _alive(pid):
        d["stale"] = True                       # process-held and the process died
    elif pid is None:
        try:
            age = time.time() - time.mktime(time.strptime(d.get("since", ""),
                                                          "%Y-%m-%dT%H:%M:%S"))
            if age > LOCK_MAX_AGE:
                d["stale"] = True               # manual hold, abandoned
            d["age_s"] = int(age)
        except Exception:
            pass
    return d


def lock_acquire(owner, note="", wait=0, pid=True):
    waited = 0
    while True:
        cur = lock_status()
        if cur is None or cur.get("stale"):
            if cur:
                print(f"breaking stale lock from pid {cur.get('pid')} "
                      f"({cur.get('owner')})", file=sys.stderr)
            os.makedirs(os.path.dirname(LOCKFILE), exist_ok=True)
            tmp = LOCKFILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump({"owner": owner, "pid": os.getpid() if pid else None,
                           "note": note,
                           "since": time.strftime("%Y-%m-%dT%H:%M:%S")}, f)
            os.replace(tmp, LOCKFILE)
            return True
        if waited >= wait:
            return False
        time.sleep(2); waited += 2


def lock_release(owner=None):
    d = _lock_read()
    if d and (owner is None or d.get("owner") == owner or not _alive(d.get("pid", -1))):
        try: os.remove(LOCKFILE)
        except FileNotFoundError: pass
        return True
    return False


def find_thread(name, cwd=None):
    """The canonical thread belonging to this chat.

    Resolution goes through the registry, keyed by the CHAT the thread was
    created for -- not by the thread's display name. Names are cosmetic and the
    owner may retype one at any moment; if resolution depended on them, a rename
    would orphan the thread and the next `new` would silently start a second one.
    Falls back to name matching for threads that predate the registry.
    """
    want_cwd = project_cwd(cwd)
    want_project = claude_project(want_cwd) or want_cwd
    want_chat_id, want_title = chat_identity()
    expected_default = (want_title
                        or os.path.basename(want_cwd.rstrip("/"))
                        or "codex session")
    automatic_name = name == expected_default
    registry = _registry()
    registry.setdefault("chats", {})
    reg = registry["threads"]
    live = {t["id"]: t for t in rpc("thread/list", {"limit": 100}, 40).get("data", [])}

    def recency(tid):
        t = live.get(tid) or {}
        return _session_recency({
            "lastActivityAt": t.get("recencyAt") or t.get("updatedAt") or 0,
        })

    best, best_ts = None, -1
    if automatic_name and want_chat_id:
        # The CHAT is the identity here, not the directory. A thread stays this
        # chat's thread even when the chat is driven from some other cwd -- the
        # tool's own bin/, a subdirectory, a sibling project -- which is exactly
        # the invariant stated above: one chat, one thread. Filtering on root
        # before the chat_id match silently broke it. A call from a different
        # directory matched nothing, and reuse-or-create then made a SECOND
        # thread for a chat that already had one.
        canonical = registry["chats"].get(want_chat_id)
        if canonical in live and (reg.get(canonical) or {}).get("chat_id") == want_chat_id:
            return canonical

        # Legacy registries may contain duplicates created by the old CWD
        # resolver but no canonical index. Pick the oldest deterministically;
        # the caller's subsequent bind_project() persists that first binding.
        matches = []
        for tid, entry in reg.items():
            if tid not in live or entry.get("chat_id") != want_chat_id:
                continue
            created = live[tid].get("createdAt")
            try: created = float(created)
            except (TypeError, ValueError): created = float("inf")
            matches.append((created, tid))
        if matches:
            return min(matches)[1]

    # Lazily migrate a title-only binding written by older Wheelhouse versions.
    # Never use this path for an entry already bound to a different stable id.
    if automatic_name:
        for tid, entry in reg.items():
            if tid not in live or entry.get("root") != want_project:
                continue
            if entry.get("chat_id") or entry.get("chat") != name:
                continue
            if recency(tid) > best_ts:
                best, best_ts = tid, recency(tid)
        if best:
            return best

    for tid, t in live.items():
        if (t.get("name") or "") != name:
            continue
        binding = reg.get(tid) or {}
        pinned = binding.get("root")
        legacy_project = claude_project(t.get("cwd"), prefer_session=False)
        if (pinned or legacy_project or t.get("cwd") or want_project) != want_project:
            continue
        # A cosmetic name collision must not cross an existing chat binding.
        bound_chat_id = binding.get("chat_id")
        if bound_chat_id and want_chat_id and bound_chat_id != want_chat_id:
            continue
        if recency(tid) > best_ts:
            best, best_ts = tid, recency(tid)
    return best


def approval_overrides(mode):
    """Mode name -> the protocol's two fields. Mirrors ui/index.html's
    approvalOverrides(), because the CLI and the UI must agree on what a mode IS.

    `auto-review` is NOT an approvalPolicy value -- it is on-request routed to the
    review agent, so it needs approvalsReviewer too. Sending the bare string as a
    policy is invalid, which is why this cannot be a one-word default change.
    """
    if not mode:
        return {}
    if mode == "auto-review":
        return {"approvalPolicy": "on-request", "approvalsReviewer": "auto_review"}
    return {"approvalPolicy": mode, "approvalsReviewer": "user"}


def new(name, cwd=None, model=None, effort=None, sandbox="workspace-write",
        approvals=DEFAULT_APPROVALS, reuse=True):
    if reuse:
        existing = find_thread(name, cwd)
        if existing:
            bind_project(existing, cwd)
            return existing
    effort = effort or DEFAULT_EFFORT
    p = {"cwd": project_cwd(cwd), "sandbox": sandbox, "threadSource": "user"}
    p.update(approval_overrides(approvals))
    if model: p["model"] = model
    if effort: p["config"] = {"model_reasoning_effort": effort}
    res = rpc("thread/start", p, 90)
    th = res.get("thread", res)
    tid = th.get("id") or res.get("threadId")
    if not tid:
        sys.exit("thread/start returned no id: " + json.dumps(res)[:200])
    rpc("thread/name/set", {"threadId": tid, "name": name}, 30)
    bind_project(tid, cwd)
    return tid


def wait_idle(tid, limit=600):
    for _ in range(limit):
        for t in rpc("thread/list", {"limit": 50}, 30).get("data", []):
            if t["id"] == tid:
                if (t.get("status") or {}).get("type") != "active":
                    return
        time.sleep(1)


def transcript(tid, tail=None):
    data = rpc("thread/turns/list", {"threadId": tid, "limit": 100,
               "sortDirection": "asc", "itemsView": "full"}, 120).get("data", [])
    out = []
    for t in data:
        for it in t.get("items", []):
            txt = it.get("text") or "".join(
                c.get("text", "") for c in (it.get("content") or []))
            if txt:
                out.append((it.get("type", ""), txt))
    return out[-tail:] if tail else out


def thread_settings(tid):
    """The thread's CURRENT effective settings, straight from the bridge.

    The protocol's thread object does not report model / effort / approvals, so
    the bridge reads what was actually used out of the state DB.
    """
    try:
        return _req(f"/threadmeta?id={tid}", None, 10) or {}
    except Exception:
        return {}


def send_file(tid, path, skill=None, skill_path=None, effort=None, cwd=None):
    """Send a long prompt from a file, optionally attaching a skill item.

    Exists because dispatches are multi-paragraph with strict output contracts;
    passing them as argv is unreadable and invites quoting bugs.
    """
    with open(os.path.expanduser(path), encoding="utf-8") as prompt:
        text = prompt.read()
    inp = _turn_input(text)
    if skill:
        inp.append({"type": "skill", "name": skill,
                    "path": skill_path or _skill_path(skill)})
    # Only send what was explicitly asked for. Omitting a parameter makes the
    # server use the THREAD's current setting -- which is what the owner sees in
    # the UI and may have deliberately changed. Forcing DEFAULT_EFFORT on every
    # turn silently reverted those changes on the next dispatch.
    p = {"threadId": tid, "input": inp}
    if effort:
        p["effort"] = effort
    # Writes are scoped to the turn's cwd under workspace-write. If the work
    # happens outside the thread's own directory (a sandbox, a worktree), the
    # turn MUST carry that cwd or every write fails with "Operation not
    # permitted" -- reads succeed, so the failure surfaces late and confusingly.
    if cwd:
        p["cwd"] = os.path.abspath(os.path.expanduser(cwd))
    # A Codex turn WRITES. Hold the tree lock for its duration so nothing else
    # edits this checkout underneath it (and vice versa).
    st = thread_settings(tid)
    print("turn: model=%s effort=%s approvals=%s%s" % (
        st.get("model") or "?",
        effort or (st.get("reasoning_effort") or "thread default"),
        st.get("approval_mode") or "?",
        "  (effort overridden)" if effort else ""), file=sys.stderr)
    held = lock_acquire(f"codex:{tid[:8]}", note="turn in progress",
                        wait=int(os.environ.get("LOCK_WAIT", "0")))
    if not held:
        cur = lock_status() or {}
        print(f"WARNING: tree lock held by {cur.get('owner')} (pid {cur.get('pid')})"
              " -- dispatching anyway, edits may interleave", file=sys.stderr)
    try:
        before = len(transcript(tid))
        rpc("turn/start", p, 1800)
        wait_idle(tid, limit=3600)
    finally:
        if held: lock_release(f"codex:{tid[:8]}")
    for ty, txt in transcript(tid)[before:]:
        if "agentMessage" in ty:
            print(txt)


def _skill_path(name):
    """Resolve a skill name to its SKILL.md via the app-server."""
    for entry in rpc("skills/list", {"forceReload": False}, 60).get("data", []):
        for sk in (entry.get("skills") or []):
            if isinstance(sk, dict) and sk.get("name") == name:
                return sk.get("path") or ""
    return ""


def agents_of(tid):
    return rpc("thread/list", {"ancestorThreadId": tid, "limit": 50}, 60).get("data", [])


def watch(tid, secs=1800):
    """Follow a run: status, sub-agents, token burn. Prints only on change."""
    start = time.time(); last = None
    while time.time() - start < secs:
        rows = rpc("thread/list", {"limit": 60}, 40).get("data", [])
        hit = [t for t in rows if t["id"] == tid]
        st = (hit[0].get("status") or {}).get("type") if hit else "not-listed"
        kids = agents_of(tid)
        ksig = " ".join(f"{k.get('agentNickname')}={(k.get('status') or {}).get('type')}"
                        for k in kids)
        sig = f"{st}  {ksig}".strip()
        if sig != last:
            try:
                m = json.load(urllib.request.urlopen(
                    f"{B}/threadmeta?id={tid}", timeout=20))
                tok = m.get("tokens_used")
            except Exception:
                tok = "?"
            print(f"  +{int(time.time()-start):5}s  {sig}  tokens={tok}", flush=True)
            last = sig
        # a not-listed blip is transient; only stop on a real idle with no active kids
        if st == "idle" and all((k.get("status") or {}).get("type") != "active" for k in kids):
            print("  -- idle --", flush=True); return True
        time.sleep(15)
    print("  -- watch window ended, still running --", flush=True); return False


def errors_of(tid):
    """Lines that look like tool/tooling errors -- the active-learning input."""
    import re
    pat = re.compile(r"(error|Error|Traceback|cannot|unable|not found|denied|"
                     r"failed|refus|missing|unsupported|not permitted|/login)")
    out = []
    for ty, txt in transcript(tid):
        if "agentMessage" not in ty:
            continue
        for line in txt.splitlines():
            if pat.search(line):
                out.append(line.strip())
    return out


def turn_protocol():
    """Codex-facing shared-checkout protocol, injected into every dispatched
    turn. Codex cannot read SKILL.md (deliberately not a Codex skill root), so
    the working agreement — lock, commit conventions, AGENTS.md symlink — must
    ride along with the dispatch or Codex has no standing instructions at all
    (observed: a repo without AGENTS.md left Codex committing with no trailer
    and writing without the lock). CODEX_NO_PROTOCOL=1 skips it."""
    if os.environ.get("CODEX_NO_PROTOCOL") == "1":
        return None
    p = os.path.join(ROOT, ".claude", "skills", "codex-run", "CODEX-TURN.md")
    try:
        with open(p, encoding="utf-8") as f:
            txt = f.read().replace("{LOCKFILE}", LOCKFILE)
    except Exception:
        return None
    return txt


def _turn_input(text):
    inp = []
    proto = turn_protocol()
    if proto:
        inp.append({"type": "text", "text": proto})
    inp.append({"type": "text", "text": text})
    return inp


def send(tid, text, model=None, effort=None):
    # Same rule as send_file: inherit the thread's settings unless overridden.
    p = {"threadId": tid, "input": _turn_input(text)}
    if model: p["model"] = model
    if effort: p["effort"] = effort
    # A send turn WRITES just like a task turn does; hold the tree lock for its
    # duration (send previously skipped this, so send-dispatched turns ran with
    # no lock held by anyone unless Codex thought to take it itself).
    held = lock_acquire(f"codex:{tid[:8]}", note="turn in progress (send)",
                        wait=int(os.environ.get("LOCK_WAIT", "0")))
    if not held:
        cur = lock_status() or {}
        print(f"WARNING: tree lock held by {cur.get('owner')} (pid {cur.get('pid')})"
              " -- dispatching anyway, edits may interleave", file=sys.stderr)
    try:
        before = len(transcript(tid))
        rpc("turn/start", p, 900)
        wait_idle(tid)
    finally:
        if held: lock_release(f"codex:{tid[:8]}")
    for ty, txt in transcript(tid)[before:]:
        if "agentMessage" in ty:
            print(txt)


def main():
    a = sys.argv[1:]
    if not a: sys.exit(__doc__)
    c = a[0]
    if c == "up":      up()
    elif c == "name":  print(default_name())
    elif c == "tid":
        t = find_thread(default_name())
        if t:
            bind_project(t)            # lazily pin threads created before this
        print(t if t else "(none yet)")
    elif c == "rename":
        # Names are cosmetic: resolution goes through the registry's chat
        # binding, so retyping one cannot lose the thread.
        if len(a) >= 3:
            tid, nm = a[1], a[2]
        else:
            tid, nm = find_thread(default_name()), a[1]
        if not tid:
            sys.exit("no thread for this chat yet")
        rpc("thread/name/set", {"threadId": tid, "name": nm}, 30)
        got = (rpc("thread/read", {"threadId": tid}, 30).get("thread") or {}).get("name")
        if got != nm:
            sys.exit(f"rename did not stick: still {got!r}")
        print(f"renamed -> {got}")
    elif c == "lock":
        sub = a[1] if len(a) > 1 else "status"
        if sub == "status":
            d = lock_status()
            print("unlocked" if not d else
                  f"held by {d.get('owner')} "
                  + (f"pid {d.get('pid')} " if d.get("pid") else "")
                  + f"since {d.get('since')}"
                  + (f" ({d['age_s']}s)" if d.get("age_s") is not None else "")
                  + ("  [STALE - owner gone]" if d.get("stale") else "")
                  + (("  " + d["note"]) if d.get("note") else ""))
        elif sub == "acquire":
            who = a[2] if len(a) > 2 else "manual"
            # manual holds outlive this process, so record no pid
            ok = lock_acquire(who, note=" ".join(a[3:]), pid=False,
                              wait=int(os.environ.get("LOCK_WAIT", "0")))
            print("acquired" if ok else "BUSY")
            if not ok: sys.exit(1)
        elif sub == "release":
            print("released" if lock_release() else "not held")
        else:
            sys.exit("lock status|acquire [owner] [note]|release")
    elif c == "project":
        root = claude_project(project_cwd())
        if not root:
            sys.exit("current path is not inside a project registered by Claude")
        if "--name" in a:
            nm = a[a.index("--name") + 1]
            reg = _registry()
            reg["roots"][root] = nm
            for tid, e in reg["threads"].items():
                if e.get("root") == root:
                    e["name"] = nm
            _registry_save(reg)
            print(f"project name set: {nm}")
        elif "--repair" in a:
            fixed, skipped = repair_projects()
            print(f"bound {fixed} previously-unpinned thread(s)")
            if skipped:
                print(f"skipped {len(skipped)} without creation metadata")
        else:
            print(f"name : {project_name(root)}")
            print(f"root : {root}")
            tid = find_thread(default_name())
            print(f"thread: {tid or '(none yet)'}")
            if tid:
                e = bind_project(tid)              # pin lazily on first look
                print(f"pinned: {e.get('name')}  <-  {e.get('root')}")
    elif c == "new":
        # name is ALWAYS the chat title -- not overridable on purpose
        cwd = a[1] if len(a) > 1 else None
        nm = default_name(cwd)
        existed = find_thread(nm, cwd)
        tid = new(nm, cwd)
        print(tid)
        if existed:
            print(f"(reused existing thread for \"{nm}\")", file=sys.stderr)
    elif c == "say":
        # codex-run say "<text>"            -> name derived from the chat title
        # codex-run say "<name>" "<text>"   -> explicit name
        if len(a) == 2:
            nm, text = default_name(), a[1]
        else:
            nm, text = a[1], a[2]
        existed = find_thread(nm)
        tid = new(nm)
        print(f"[{tid}] {nm}{' (reused)' if existed else ' (new)'}", file=sys.stderr)
        send(tid, text)
    elif c == "send":  send(a[1], a[2])
    elif c == "task":
        # codex-run task <id> <file> [--effort E] [--cwd DIR] [--skill NAME]
        eff = cwdo = sk = None
        rest = a[3:]
        i = 0
        while i < len(rest):
            if rest[i] == "--effort" and i + 1 < len(rest): eff = rest[i+1]; i += 2
            elif rest[i] == "--cwd" and i + 1 < len(rest): cwdo = rest[i+1]; i += 2
            elif rest[i] == "--skill" and i + 1 < len(rest): sk = rest[i+1]; i += 2
            else:
                if rest[i] in ("low","medium","high","xhigh","max","ultra"): eff = rest[i]
                else: sk = rest[i]
                i += 1
        send_file(a[1], a[2], sk, effort=eff, cwd=cwdo)
    elif c == "reload":
        up(quiet=True)
        urllib.request.urlopen(B + "/reload", timeout=10).read()
        print("reloaded (UI only — no turn interrupted)")
    elif c == "busy":
        act = [t for t in rpc("thread/list", {"limit": 60}, 40).get("data", [])
               if (t.get("status") or {}).get("type") == "active"]
        for t in act:
            print(f"ACTIVE {t['id']}  {t.get('name')}")
        if not act:
            print("idle")
        sys.exit(1 if act else 0)
    elif c == "restart":
        # The bridge OWNS codex app-server as a child: killing it kills any
        # running turn outright (observed -- a user message was accepted, then
        # destroyed 6s later by a restart). UI changes need only a page reload,
        # so a restart is almost never the right tool.
        force = "--force" in a
        act = []
        try:
            act = [t for t in rpc("thread/list", {"limit": 60}, 40).get("data", [])
                   if (t.get("status") or {}).get("type") == "active"]
        except Exception:
            pass
        if act and not force:
            for t in act:
                print(f"REFUSING: {t['id']} is mid-turn ({t.get('name')})")
            print("A restart would abort it. Wait, or pass --force to destroy it.")
            print("If you only changed ui/index.html, reload the page instead "
                  "(Cmd-R in the app) -- the bridge serves it fresh.")
            sys.exit(1)
        subprocess.run(["pkill", "-f", f"{APP}/Contents/MacOS"], check=False)
        time.sleep(1)
        subprocess.run(["pkill", "-f", BRIDGE_PY], check=False)
        time.sleep(1)
        subprocess.run(["open", APP], check=False)
        for _ in range(120):
            if alive():
                print("restarted"); return
            time.sleep(0.5)
        print("restarted (bridge slow to answer)")
    elif c == "on-file":
        # Codex cannot wait on anything: a turn ends and that is that. So the
        # orchestrator waits, then dispatches. Waits for the file to exist AND
        # to stop changing size, so a half-written file is never consumed.
        target = os.path.expanduser(a[1])
        tid, taskfile = a[2], a[3]
        rest = a[4:]
        eff = cwdo = None
        i = 0
        while i < len(rest):
            if rest[i] == "--effort" and i + 1 < len(rest): eff = rest[i+1]; i += 2
            elif rest[i] == "--cwd" and i + 1 < len(rest): cwdo = rest[i+1]; i += 2
            else: i += 1
        print(f"waiting for {target} ...", flush=True)
        last, stable, waited = -1, 0, 0
        while waited < 6 * 3600:
            if os.path.exists(target):
                sz = os.path.getsize(target)
                stable = stable + 1 if sz == last else 0
                last = sz
                if stable >= 3:               # unchanged across 3 polls
                    print(f"{target} ready ({sz:,} bytes)", flush=True)
                    break
            time.sleep(20); waited += 20
        else:
            sys.exit(f"timed out waiting for {target}")
        # do not stomp a turn that is still running
        while True:
            rows = rpc("thread/list", {"limit": 60}, 40).get("data", [])
            act = [t for t in rows if t["id"] == tid
                   and (t.get("status") or {}).get("type") == "active"]
            if not act: break
            print("  thread busy, waiting for it to finish...", flush=True)
            time.sleep(30)
        send_file(tid, taskfile, effort=eff, cwd=cwdo)
    elif c == "queue":
        r = rpc("thread/queue/add", {"threadId": a[1],
                "input": _turn_input(a[2]),
                "clientUserMessageId": f"cr-{int(time.time()*1000)}"}, 60)
        print("queued" if r is not None else "queue failed")
    elif c == "stop":
        turns = rpc("thread/turns/list", {"threadId": a[1], "limit": 1,
                    "sortDirection": "desc"}, 60).get("data", [])
        if not turns:
            print("no turn to stop")
        else:
            r = rpc("turn/interrupt", {"threadId": a[1], "turnId": turns[0]["id"]}, 60)
            print("interrupted")
    elif c == "watch":
        watch(a[1], int(a[2]) if len(a) > 2 else 1800)
    elif c == "agents":
        for k in agents_of(a[1]):
            print(f"{k['id']}  {(k.get('status') or {}).get('type'):9} "
                  f"{k.get('agentNickname') or ''}")
    elif c == "errors":
        for line in errors_of(a[1]):
            print(line)
    elif c == "steer":
        st = rpc("thread/read", {"threadId": a[1]}, 60)
        turns = rpc("thread/turns/list", {"threadId": a[1], "limit": 1,
                    "sortDirection": "desc"}, 60).get("data", [])
        if not turns: sys.exit("no active turn to steer")
        rpc("turn/steer", {"threadId": a[1], "expectedTurnId": turns[0]["id"],
                           "input": [{"type": "text", "text": a[2]}]}, 120)
        print("steered")
    elif c == "list":
        for t in rpc("thread/list", {"limit": 50}, 30).get("data", []):
            st = (t.get("status") or {}).get("type", "?")
            print(f"{t['id']}  {st:9}  {t.get('name') or (t.get('preview') or '')[:50]}")
    elif c == "info":
        print(json.dumps(json.load(urllib.request.urlopen(
            f"{B}/threadmeta?id={a[1]}", timeout=20)), indent=1))
    elif c == "read":
        for ty, txt in transcript(a[1]): print(f"[{ty}] {txt}")
    elif c == "archive":
        # sub-agents belong to their parent -- archive the tree together
        kids = rpc("thread/list", {"ancestorThreadId": a[1], "limit": 50}, 40).get("data", [])
        for k in kids:
            rpc("thread/archive", {"threadId": k["id"]}, 30)
        rpc("thread/archive", {"threadId": a[1]}, 30)
        extra = f" + {len(kids)} sub-agent(s)" if kids else ""
        print(f"archived (transcript kept){extra}")
    elif c == "rm":
        try:
            up(quiet=True)
            # Sub-agent threads persist their own rollouts; deleting only the
            # parent orphans them. Remove the tree.
            kids = rpc("thread/list", {"ancestorThreadId": a[1], "limit": 50}, 40)\
                   .get("data", [])
            for k in kids:
                _req("/rpc", {"method": "thread/delete",
                              "params": {"threadId": k["id"]}, "timeout": 30}, 50)
            if kids:
                print(f"deleted {len(kids)} sub-agent thread(s)")
            r = _req("/rpc", {"method": "thread/delete",
                              "params": {"threadId": a[1]}, "timeout": 30}, 50)
            if "error" in r:
                m = json.dumps(r["error"])
                if "no rollout" in m:
                    print("nothing to delete (thread never persisted a rollout)")
                else:
                    sys.exit("thread/delete failed: " + m[:300])
            else:
                print("deleted (rollout destroyed)")
        except urllib.error.URLError as e:
            sys.exit(f"bridge unreachable: {e}")
    else: sys.exit(__doc__)


if __name__ == "__main__":
    main()
